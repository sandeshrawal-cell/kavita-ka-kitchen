SUPABASE_URL=https://your-existing-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_existing_key
# Server only. Required for account deletion. NEVER prefix this with PUBLIC or VITE.
SUPABASE_SERVICE_ROLE_KEY=
# Existing production origin, used for privileged-operation CSRF protection.
APP_ORIGIN=https://kavita-kitchen-v2.vercel.app
# Optional after importing master catalogue SQL: static or supabase
CATALOG_SOURCE=static

# Optional AI: choose a Responses API model supporting images and structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
